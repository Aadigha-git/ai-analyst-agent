DATABASE_URL=postgresql://analyst:analyst@localhost:5432/analyst
READONLY_DATABASE_URL=postgresql://analyst_readonly:change_me@localhost:5432/analyst

# LLM provider: nebius | openai | anthropic | google (default: nebius)
LLM_PROVIDER=nebius
# Optional override; defaults are provider-specific if unset
# LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Only the selected provider's API key is required — leave the others blank/commented.
NEBIUS_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Nebius-specific (ignored by other providers)
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_TIMEOUT_SECONDS=120
NEBIUS_MAX_RETRIES=3

# Packaged --compare-models demo (CR-2 / ADR-011 CR-2): comma-separated Nebius-
# hosted model ids across size/capability tiers. Verified against Nebius AI
# Studio GET /models on 2026-09-18 — re-check the catalog before relying on
# these strings; hosted model availability changes over time.
NEBIUS_COMPARE_MODELS=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B,openai/gpt-oss-120b,Qwen/Qwen3-235B-A22B-Instruct-2507

# Provider default models (set LLM_MODEL to override whichever provider is active):
#   nebius:    Qwen/Qwen3-235B-A22B-Instruct-2507
#   openai:    gpt-4o-mini
#   anthropic: claude-sonnet-4-20250514
#   google:    gemini-2.0-flash
#
# MCP server (optional): python -m src.mcp_server
# Same LLM_* / NEBIUS_* / ROW_LIMIT vars apply; database_url is passed per tool call.

MAX_ITERATIONS=8
ROW_LIMIT=500
QUERY_TIMEOUT_SECONDS=10
